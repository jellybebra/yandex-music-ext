{
  "manifest_version": 3,
  "name": "Старый дизайн Яндекс Музыки",
  "version": "1.0",
  "description": "Возвращает классическое отображение Моей Волны",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.yandex.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
