{
  "manifest_version": 3,
  "name": "Старый дизайн Яндекс Музыки",
  "version": "1.2",
  "description": "Возвращает классическое отображение Моей Волны",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://music.yandex.ru/*",
    "*://music.yandex.by/*",
    "*://music.yandex.kz/*",
    "*://music.yandex.uz/*",
    "*://music.yandex.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Настройки старого дизайна",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
