{
  "manifest_version": 3,
  "name": "Старый дизайн Яндекс Музыки",
  "version": "1.2",
  "description": "Возвращает классическое отображение Моей Волны",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://music.yandex.ru/*",
    "*://music.yandex.by/*",
    "*://music.yandex.kz/*",
    "*://music.yandex.uz/*",
    "*://music.yandex.com/*"
  ],
  "icons": {
    "128": "icon.jpg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Настройки старого дизайна",
    "default_icon": "icon.jpg",
    "default_popup": "popup.html"
  }
}
